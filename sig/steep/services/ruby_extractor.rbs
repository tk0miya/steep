module Steep
  module Services
    # Extracts the Ruby code embedded in a file, like ERB templates
    #
    # An extractor is chosen by the path of the file, and has no state.
    # The extracted code keeps the positions of the characters in the file,
    # so the diagnostics are reported on the original position.
    #
    module RubyExtractor
      interface _Extractor
        def extract: (String content) -> Result
      end

      # An error in the declaration of the local variables, like a syntax error of the types
      #
      class Error
        attr_reader message: String

        attr_reader location: RBS::Location[untyped, untyped]

        def initialize: (message: String, location: RBS::Location[untyped, untyped]) -> void
      end

      # The Ruby code of a file, and the local variables defined outside of the code
      #
      class Result
        attr_reader code: String

        # Types of the local variables defined outside of the code
        attr_reader locals: Hash[Symbol, RBS::Types::t]

        # Errors in the declaration of the local variables
        attr_reader errors: Array[Error]

        def initialize: (code: String, ?locals: Hash[Symbol, RBS::Types::t], ?errors: Array[Error]) -> void

        # Types of the locals; the type is `untyped` if it is invalid
        def local_variable_types: (Subtyping::Check subtyping) -> Hash[Symbol, AST::Types::t]

        # Returns the types of the locals, and the diagnostics of the declaration of the locals
        def resolve_locals: (Subtyping::Check subtyping) -> [Hash[Symbol, AST::Types::t], Array[Diagnostic::Ruby::Base]]
      end

      # Extracts the Ruby code from a `TypeCheckService::SourceFile`
      def self.extract: (TypeCheckService::SourceFile source_file) -> Result

      def self.for: (Pathname path) -> _Extractor

      # Ruby files; the content is the Ruby code
      class Plain
        include _Extractor
      end

      # ERB files; the ERB tags are replaced with spaces
      class Erb
        include _Extractor

        class Scanner
          @scanner: StringScanner

          @result: String

          # Raises `EncodingError` if the content has invalid bytes
          def self.extract: (String content) -> String

          def initialize: (String content) -> void

          def extract: () -> String

          private

          attr_reader scanner: StringScanner

          def blank: (String text) -> void

          def scan_tag: () -> void
        end
      end

      # HTML+ERB files, like the views of Rails
      #
      # The HTML and the ERB tags are removed in the same way as `Erb`. The `locals` are declared in the same way as Rails, and the types are given by the next comment starting with `#:`.
      #
      class HtmlErb
        include _Extractor

        STRICT_LOCALS: Regexp

        COMMENT_TAG: Regexp

        TYPES_COMMENT: Regexp

        private

        def locals: (Array[Symbol] names, Hash[Symbol, RBS::Types::t] types) -> Hash[Symbol, RBS::Types::t]

        # Returns the names of the keywords and the keyword rest parameter, or `nil` if the declaration is not valid Ruby
        #
        # The name of the keyword rest parameter is `true` if it is anonymous, and `nil` if it is not declared.
        #
        def local_names: (String parameters) -> [Array[Symbol], Symbol | true | nil]?

        # Returns the types of the locals and the errors of the types given in `range` of `content`
        def local_types: (String content, Range[Integer] range, Array[Symbol] keywords, Symbol | true | nil rest) -> [Hash[Symbol, RBS::Types::t], Array[Error]]
      end
    end
  end
end
